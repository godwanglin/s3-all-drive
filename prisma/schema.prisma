datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  googleDriveAccounts GoogleDriveAccount[]
  buckets             Bucket[]
  apiKeys             ApiKey[]
  customDomains       CustomDomain[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model GoogleDriveAccount {
  id              String    @id @default(cuid())
  userId          String
  googleAccountId String
  email           String
  name            String?
  picture         String?   @db.Text
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, googleAccountId])
  @@index([userId])
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ObjectStatus {
  PENDING
  UPLOADING
  AVAILABLE
  FAILED
  DELETING
  DELETED
}

model Bucket {
  id        String   @id @default(cuid())
  ownerId   String
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  maxBytes  BigInt?
  usedBytes BigInt   @default(0)
  isActive  Boolean  @default(true)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]
  folders   StorageFolder[]
  objects   StorageObject[]
  domains   CustomDomain[]
  @@unique([ownerId, slug])
  @@index([ownerId, isActive])
}

model ApiKey {
  id          String       @id @default(cuid())
  ownerId     String
  bucketId    String
  keyPrefix   String       @unique @db.VarChar(32)
  keyHash     String       @db.VarChar(255)
  secretEncrypted String?      @db.Text
  name        String       @db.VarChar(255)
  permissions Json
  status      ApiKeyStatus  @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bucket      Bucket        @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  @@index([ownerId, bucketId])
  @@index([status, expiresAt])
}

model StorageFolder {
  id        String         @id @default(cuid())
  bucketId  String
  parentId  String?
  name      String         @db.VarChar(255)
  path      String         @db.VarChar(500)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  bucket    Bucket         @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  parent    StorageFolder?  @relation("StorageFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  StorageFolder[] @relation("StorageFolderTree")
  objects   StorageObject[]
  @@unique([bucketId, path])
  @@index([bucketId, parentId])
}

model StorageObject {
  id                String       @id @default(cuid())
  bucketId          String
  folderId          String?
  name              String       @db.VarChar(255)
  originalName      String?      @db.VarChar(255)
  logicalPath       String       @db.VarChar(500)
  mimeType          String?      @db.VarChar(150)
  fileSize          BigInt
  providerAccountId String?
  providerFileId    String?
  status            ObjectStatus @default(PENDING)
  isPublic          Boolean      @default(false)
  publicUrlToken    String?      @unique @db.VarChar(128)
  publicUrlExpiresAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bucket            Bucket       @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  folder            StorageFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  @@unique([bucketId, logicalPath])
  @@index([bucketId, folderId, status])
}

model CustomDomain {
  id         String   @id @default(cuid())
  ownerId    String
  bucketId   String?
  domain     String   @unique @db.VarChar(255)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bucket     Bucket?  @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  @@index([ownerId])
}


